*.code-workspace
*.suo
*.user
Thumbs.db
desktop.ini

# Local environment and signing credentials
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
key.properties

# Keep the public README, maintained project documentation, and repository
# guidance under version control; keep other working documents local.
/docs/*
!/docs/architecture.md
!/docs/development.md
!/docs/requirements.md
!/docs/adr/
!/docs/adr/*.md

# macOS system metadata and Finder files
.AppleDouble
.LSOverride
._*
Icon?
.Spotlight-V100/
.Trashes/
.fseventsd
.TemporaryItems/
.DocumentRevisions-V100/
.apdisk
*.icloud

